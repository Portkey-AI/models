            }
          },
          {
            "value": "json_schema",
            "name": "JSON Schema",
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "value": "json_schema"
                },
                "json_schema": {
                  "type": "object"
                }
              }
            },
            "params": {
              "key": "json_schema",
              "defaultValue": null,
              "type": "json",
              "skipValues": [null]
            }
          }
        ],
        "skipValues": [null],
        "type": "string"
      }
    ],
    "messages": {
      "options": ["system", "user", "assistant", "developer", "tool"]
    },
    "type": {
      "primary": "chat",
      "supported": ["tools", "reasoning"]
    }
