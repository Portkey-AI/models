{
  "name": "apimodels",
  "description": "apimodels.app is a pay-as-you-go AI API gateway: one OpenAI-compatible key (https://api.apimodels.app/v1) for Claude, GPT, Gemini, Grok and DeepSeek chat models and image generation models, with automatic failover across serving routes and no charge for failed calls.",
  "default": {
    "params": [
      {
        "key": "max_tokens",
        "defaultValue": 4096,
        "minValue": 1,
        "maxValue": 128000
      },
      {
        "key": "temperature",
        "defaultValue": 1,
        "minValue": 0,
        "maxValue": 2
      },
      {
        "key": "top_p",
        "defaultValue": 1,
        "minValue": 0,
        "maxValue": 1
      },
      {
        "key": "stop",
        "defaultValue": null,
        "type": "array-of-strings",
        "skipValues": [null, []]
      },
      {
        "key": "stream",
        "defaultValue": true,
        "type": "boolean"
      }
    ],
    "messages": {
      "options": ["system", "user", "assistant", "developer", "tool"]
    },
    "type": {
      "primary": "chat",
      "supported": ["tools"]
    }
  },
